# TWRP user-facing partitions and storage flags

# Removable storage
/external_sd    vfat    /dev/block/mmcblk1p1    /dev/block/mmcblk1      flags=display="Micro SD Card";storage;wipeingui;removable
/usb_otg        auto    /dev/block/sda1         /dev/block/sda          flags=display="USB-OTG";storage;wipeingui;removable

# Flashable Images & Boot Partitions
/boot           emmc    /dev/block/by-name/boot                         flags=display="Boot";backup=1;flashimg=1;slotselect
/vendor_boot    emmc    /dev/block/by-name/vendor_boot                  flags=display="Vendor Boot";backup=1;flashimg=1;slotselect
/init_boot      emmc    /dev/block/by-name/init_boot                    flags=display="Init Boot";backup=1;flashimg=1;slotselect
/recovery       emmc    /dev/block/by-name/recovery                     flags=display="Recovery";backup=1;flashimg=1;slotselect
/dtbo           emmc    /dev/block/by-name/dtbo                         flags=display="DTBO";backup=1;flashimg=1;slotselect
/vbmeta         emmc    /dev/block/by-name/vbmeta                       flags=display="VBMeta";backup=1;flashimg=1;slotselect
/vbmeta_system  emmc    /dev/block/by-name/vbmeta_system                flags=display="VBMeta System";backup=1;flashimg=1;slotselect
/vbmeta_vendor  emmc    /dev/block/by-name/vbmeta_vendor                flags=display="VBMeta Vendor";backup=1;flashimg=1;slotselect

# Dynamic Partitions (Image backup)
/system_image   emmc    /dev/block/bootdevice/by-name/system            flags=display="System Image";backup=1;flashimg=1
/vendor_image   emmc    /dev/block/bootdevice/by-name/vendor            flags=display="Vendor Image";backup=1;flashimg=1
/product_image  emmc    /dev/block/bootdevice/by-name/product           flags=display="Product Image";backup=1;flashimg=1
/odm_image      emmc    /dev/block/bootdevice/by-name/odm               flags=display="ODM Image";backup=1;flashimg=1
/my_product_image     emmc    /dev/block/bootdevice/by-name/my_product       flags=display="My Product Image";backup=1;flashimg=1
/my_engineering_image emmc    /dev/block/bootdevice/by-name/my_engineering   flags=display="My Engineering Image";backup=1;flashimg=1

# Modem, Cache & EFS
/modem          emmc    /dev/block/bootdevice/by-name/modem             flags=display="Modem (Firmware)";backup=1;slotselect
/modem_st1      emmc    /dev/block/bootdevice/by-name/modem_st1         flags=display="EFS (Modem ST1)";backup=1
/modem_st2      emmc    /dev/block/bootdevice/by-name/modem_st2         flags=display="EFS (Modem ST2)";backup=1
/persist        ext4    /dev/block/bootdevice/by-name/persist           flags=display="Persist";backup=1
/cache          ext4    /dev/block/bootdevice/by-name/oplusreserve2     flags=display="Cache / Oplus Reserve";backup=1
